# Copy to backend/.env and fill in. NEVER commit .env.

# ---- Mode -------------------------------------------------------------------
# memory   = local demo: JSON-file DB + files in backend/data, no Supabase needed
# supabase = real Supabase Postgres + Storage (production)
DB_BACKEND=memory
# dev      = no login, fixed demo user (only for DB_BACKEND=memory)
# supabase = verify the frontend's login token with Supabase Auth
AUTH_MODE=dev

# ---- Gemini (required for ingestion, search, generation, chat) ---------------
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
# Optional: a second embedding model to try automatically if the first is rejected
EMBEDDING_FALLBACK_MODEL=
EMBEDDING_DIM=768
GEMINI_RPM=10
EMBED_RPM=100

# ---- OpenAI (optional fallback for text generation only) ----------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_FALLBACK_TO_OPENAI=true

# ---- Supabase (required when DB_BACKEND=supabase / AUTH_MODE=supabase) -------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=sources

# LLM rerank of the top 10 chunks (one extra call per query; improved MRR in eval)
RERANK_WITH_LLM=true

# ---- Chroma -------------------------------------------------------------------
# embedded = in-process PersistentClient (default, no server)
CHROMA_MODE=embedded
# CHROMA_PATH=./data/chroma

# ---- Misc -----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
