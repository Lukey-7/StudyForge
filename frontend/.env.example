# Where the FastAPI backend runs.
VITE_API_URL=http://localhost:8080

# Supabase project (Settings -> API). Leave BOTH empty for local demo mode:
# no login screen, requests go out without an Authorization header
# (works with the backend's AUTH_MODE=dev).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
